{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "World": "Data Source=realmdom.db"
  },
  "World": {
    "Provider": "sqlite",
    "AllowedOrigins": [ "https://eladhefetz.github.io", "http://localhost:8765" ],
    "Generator": {
      "MinSpacingMeters": 70,
      "MaxPerCell": 12,
      "MaxRoadFallbacks": 4,
      "ExclusionRadiusMeters": 60,
      "FortressMinLandmarks": 8
    },
    "Regions": [],
    "Overpass": {
      "TimeoutSeconds": 30
    }
  }
}
